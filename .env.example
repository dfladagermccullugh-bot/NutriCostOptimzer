# AI API Configuration (optional - enables natural language food input)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# USDA FoodData Central API Key (optional - enables API fallback for unknown foods)
# Get a free key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# AI endpoint SSRF guard (audit M2). By default the server only forwards keys to known
# OpenAI-compatible providers over https. To allow more:
#   AI_ENDPOINT_ALLOWLIST: extra comma-separated hostnames (e.g. my-llm.example.com)
#   AI_ALLOW_ANY_ENDPOINT: set to "true" on a TRUSTED single-user/self-hosted instance to
#                          disable the allowlist entirely (allows localhost/LAN endpoints).
AI_ENDPOINT_ALLOWLIST=
AI_ALLOW_ANY_ENDPOINT=
